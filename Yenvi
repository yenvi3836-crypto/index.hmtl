# ---------- ORIGINAL CHILL MUSIC ----------
@st.cache_data
def make_music():
    rate = 22050
    duration = 8
    buffer = io.BytesIO()

    with wave.open(buffer, "wb") as wav:
        wav.setnchannels(1)
        wav.setsampwidth(2)
        wav.setframerate(rate)

        frames = bytearray()
        notes = [261.63, 329.63, 392.00, 329.63]

        for i in range(rate * duration):
            t = i / rate
            freq = notes[int(t / 2) % len(notes)]
            fade = min(1, t * 2, (duration-t) * 2)
            sound = (
                math.sin(2 * math.pi * freq * t) * 0.10
                + math.sin(2 * math.pi * freq * 0.5 * t) * 0.05
            )
            value = int(32767 * sound * max(0, fade))
            frames.extend(struct.pack("<h", value))

        wav.writeframes(frames)

    return buffer.getvalue()

