    st.subheader(f"🏪 Ngày {difficulty}: Cửa hàng đang hoạt động")

    if difficulty <= 3:
        level = "Dễ"
    elif difficulty <= 6:
        level = "Trung bình"
    elif difficulty <= 8:
        level = "Khó"
    else:
        level = "Cực khó"

    st.info(f"Độ khó: {level}")

    avatar, info = st.columns([1, 2])

    customer = random.Random(st.session_state.day * 17).choice(CUSTOMERS)

    with avatar:
        st.markdown(
            f'<div class="customer"><h1>{customer[0]}</h1>'
            f'<h3>{customer[1]}</h3></div>',
            unsafe_allow_html=True
        )

    with info:
        order = st.session_state.order
        st.markdown('<div class="shop-card">', unsafe_allow_html=True)
        st.subheader("💬 Khách hàng yêu cầu:")
        st.write(f'"{PRODUCTS[order]["hint"]}"')
        st.write("Hãy chọn đúng sản phẩm nhé!")
        st.markdown('</div>', unsafe_allow_html=True)

    # Difficulty: fewer attempts as game progresses
    if difficulty <= 3:
        choices = list(PRODUCTS.keys())
    elif difficulty <= 6:
        choices = list(PRODUCTS.keys())
    else:
        choices = list(PRODUCTS.keys())

    selected = st.selectbox(
        "📦 Chọn sản phẩm để bán:",
        choices,
        key=f"choice_{difficulty}"
    )

    price = PRODUCTS[order]["price"]

    if st.button("🛒 GIAO HÀNG CHO KHÁCH", use_container_width=True):
        if selected == order:
            bonus = difficulty * 3
            st.session_state.money += price + bonus
            st.session_state.reputation = min(
                100, st.session_state.reputation + 3
            )
            st.session_state.served += 1
            st.session_state.message = (
                f"🥰 Khách hàng vui vẻ! +{price + bonus} xu"
            )
        else:
            st.session_state.money = max(
                0, st.session_state.money - 10
            )
            st.session_state.reputation -= 15 + difficulty
            st.session_state.mistakes += 1
            st.session_state.message = (
                "😡 Khách hàng tức giận! Bạn đã giao sai hàng!"
            )

        st.session_state.day += 1

        if st.session_state.reputation <= 0 or st.session_state.mistakes >= 4:
            finish_game("lose")
        elif st.session_state.day > 10:
            if st.session_state.served >= 7 and st.session_state.money > 0:
                finish_game("win")
            else:
                finish_game("lose")
        else:
            new_order()

        st.rerun()

    st.markdown(
        f'<div class="shop-card"><h3>{st.session_state.message}</h3></div>',
        unsafe_allow_html=True
    )

